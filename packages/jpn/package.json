{
  "name": "@z-rack/jpn",
  "version": "0.0.0",
  "description": "",
  "homepage": "https://github.com/tai-kun/z-rack",
  "license": "MIT",
  "author": "tai-kun",
  "repository": {
    "url": "https://github.com/tai-kun/z-rack"
  },
  "files": [
    "dist",
    "lib",
    "package.json",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    },
    "./vibrato.wasm": "./dist/build/vibrato_wasm.wasm"
  },
  "scripts": {
    "prebuild": "cargo install wasm-pack wasm-opt",
    "build": "run-s build:*",
    "build:wasm": "run-s build:wasm:*",
    "build:wasm:pack": "wasm-pack build --target bundler --out-dir build",
    "build:wasm:wasm": "node scripts/build.js",
    "build:wasm:opt": "wasm-opt -Oz build/vibrato_wasm.wasm -o build/vibrato_wasm.wasm",
    "build:lib": "tsc --project ./.config/tsconfig.build.json"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@z-rack/core": "workspace:*",
    "call-fn-once": "^0.0.6"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^24.13.2",
    "@vitest/browser": "^4.1.9",
    "@vitest/browser-playwright": "^4.1.9",
    "npm-check-updates": "^20.0.2",
    "npm-run-all2": "^8.0.4",
    "playwright": "^1.61.1",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "@logtape/logtape": "^2.0.0"
  }
}
